SHARED_INFRA_BIND_IP=100.64.0.1
SHARED_INFRA_HOST=100.64.0.1
DOCKER_ENDPOINT=ssh://your-user@100.64.0.1
DOCKER_CONTEXT=wardroom
DASHBOARD_URL=http://devbox
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me
REDIS_PASSWORD=change-me
MINIO_ROOT_USER=shared-infra
MINIO_ROOT_PASSWORD=change-me-now
DASHBOARD_PASSWORD=replace-with-a-unique-password-16-chars-minimum
# The Compose wrapper generates DASHBOARD_SESSION_SECRET and AI_SETTINGS_KEY in private .env.
DASHBOARD_BIND_IP=0.0.0.0
TELEMETRY_TOKEN=replace-with-a-random-token-at-least-32-characters
RI_ENCRYPTION_KEY=replace-with-a-random-key-at-least-32-characters
# Optional API workbench. Use this same hostname to sign into the dashboard.
HOPPSCOTCH_HOST=devbox
# make api-up generates its database password and encryption key in .env.
# Optional MCP: mandatory bearer token, reachable through the dashboard gateway.
# Comma-separated gateway IP / DNS names, without scheme or port.
# Use the Tailnet address for encrypted transport; LAN HTTP exposes tokens.
MCP_ALLOWED_HOSTS=localhost
# Generated into private .env on first make up. Used by the private container broker.
